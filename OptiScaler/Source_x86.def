; x86 .def for OptiScaler built as d3d9.dll wrapper.
;
; Each exported function in exports/d3d9.h is declared
; extern "C" + WINAPI (__stdcall). On x86 the MSVC decoration for
; C-linkage stdcall is "_<source-name>@<arg-bytes>". Since the source
; names already start with '_' (e.g. _Direct3DCreate9Export), the
; resulting symbols carry a double underscore: __Direct3DCreate9Export@4.
; That's what we point the public export names at.
;
; The x64 build uses Source.def; this file is for Phase 1 / Win32
; only and intentionally exposes just the d3d9 surface.

EXPORTS
Direct3DCreate9 = __Direct3DCreate9Export@4 @200 PRIVATE
Direct3DCreate9Ex = __Direct3DCreate9ExExport@8 @201 PRIVATE
D3DPERF_BeginEvent = __D3DPERF_BeginEventExport@8 @202 PRIVATE
D3DPERF_EndEvent = __D3DPERF_EndEventExport@0 @203 PRIVATE
D3DPERF_SetMarker = __D3DPERF_SetMarkerExport@8 @204 PRIVATE
D3DPERF_SetRegion = __D3DPERF_SetRegionExport@8 @205 PRIVATE
D3DPERF_QueryRepeatFrame = __D3DPERF_QueryRepeatFrameExport@0 @206 PRIVATE
D3DPERF_SetOptions = __D3DPERF_SetOptionsExport@4 @207 PRIVATE
D3DPERF_GetStatus = __D3DPERF_GetStatusExport@0 @208 PRIVATE
